# Copy to apps/api/.env. Local development only.
# Migrations: nextbank_migrator role (database owner). The API never uses this URL.
MIGRATION_DATABASE_URL=postgres://nextbank_migrator:troque-me-migrator@127.0.0.1:5432/nextbank?sslmode=disable

# API: nextbank_app role (least privilege).
DATABASE_URL=postgres://nextbank_app:troque-me-app@127.0.0.1:5432/nextbank?sslmode=disable
# Integration tests: same role, separate database.
TEST_DATABASE_URL=postgres://nextbank_app:troque-me-app@127.0.0.1:5432/nextbank_test?sslmode=disable
# Test database setup (reset + migrations): migrator role. Never used by the API.
TEST_MIGRATION_DATABASE_URL=postgres://nextbank_migrator:troque-me-migrator@127.0.0.1:5432/nextbank_test?sslmode=disable

# Access token signing key: Ed25519, PKCS#8 DER in base64 (threat model D4).
# CPF keys: 32 random bytes each, in base64, and different from each other.
# Generate local values with: node scripts/generate-dev-keys.ts >> .env
JWT_PRIVATE_KEY=replace-with-generated-value
JWT_KEY_ID=dev-key
PII_ENCRYPTION_KEY=replace-with-generated-value
PII_HMAC_KEY=replace-with-generated-value
PII_KEY_VERSION=1
# PIN pepper: 32 random bytes in base64, different from the CPF keys (threat model API-13).
PIN_PEPPER=replace-with-generated-value
