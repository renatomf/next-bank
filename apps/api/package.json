{
  "name": "@nextbank/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --env-file=.env --watch src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:chaos": "vitest run --config vitest.chaos.config.ts",
    "typecheck": "tsc",
    "lint": "eslint --max-warnings 0 .",
    "arch": "depcruise src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:new": "dbmate -e MIGRATION_DATABASE_URL new",
    "db:migrate": "dbmate -e MIGRATION_DATABASE_URL --no-dump-schema up",
    "db:status": "dbmate -e MIGRATION_DATABASE_URL status",
    "contract": "node scripts/generate-openapi.ts ../../packages/contracts/openapi.json",
    "contract:admin": "node scripts/generate-openapi.ts ../../packages/contracts/openapi-admin.json --admin",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "staff:create": "node --env-file-if-exists=.env scripts/create-staff.ts",
    "measure": "node scripts/measure-latency.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dbmate": "^2.37.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.1",
    "@nextbank/simulator": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@sentry/node": "^10.76.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "otpauth": "9.5.2",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
