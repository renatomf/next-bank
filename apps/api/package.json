{
  "name": "@nextbank/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --env-file=.env --watch src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "lint": "eslint --max-warnings 0 .",
    "arch": "depcruise src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:new": "dbmate -e MIGRATION_DATABASE_URL new",
    "db:migrate": "dbmate -e MIGRATION_DATABASE_URL --no-dump-schema up",
    "db:status": "dbmate -e MIGRATION_DATABASE_URL status",
    "contract": "node scripts/generate-openapi.ts ../../packages/contracts/openapi.json",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "measure": "node scripts/measure-latency.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dbmate": "^2.36.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@node-rs/argon2": "2.2.1",
    "@sentry/node": "^10.76.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
