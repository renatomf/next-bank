{
  "name": "@nextbank/simulator",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --env-file=.env --watch src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:new": "dbmate -e SIMULATOR_MIGRATION_DATABASE_URL --migrations-table simulator_migrations new",
    "db:migrate": "dbmate -e SIMULATOR_MIGRATION_DATABASE_URL --migrations-table simulator_migrations --no-dump-schema up"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dbmate": "^2.36.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
