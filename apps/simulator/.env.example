# Copy to apps/simulator/.env. Local development only: the simulator of the
# Bacen and the other partners (v1.2.0 plan, D2 and D13). Made-up data only.
# Migrations: nextbank_migrator role, as for the API. The simulator never uses it.
SIMULATOR_MIGRATION_DATABASE_URL=postgres://nextbank_migrator:troque-me-migrator@127.0.0.1:5432/nextbank?sslmode=disable
# The simulator: its own role, which reaches only the simulator schema (S1).
SIMULATOR_DATABASE_URL=postgres://nextbank_simulator:troque-me-simulator@127.0.0.1:5432/nextbank?sslmode=disable
# Tests: the same roles on the test database.
TEST_SIMULATOR_DATABASE_URL=postgres://nextbank_simulator:troque-me-simulator@127.0.0.1:5432/nextbank_test?sslmode=disable
TEST_SIMULATOR_MIGRATION_DATABASE_URL=postgres://nextbank_migrator:troque-me-migrator@127.0.0.1:5432/nextbank_test?sslmode=disable

# The participant's key the API presents on every call (EXT-09), and the
# secret the simulator signs its webhooks with (EXT-01). 32 random bytes in
# base64 each, different from each other and from the API's keys.
SIMULATOR_PARTICIPANT_KEY=replace-with-generated-value
SIMULATOR_WEBHOOK_SECRET=replace-with-generated-value
# Where the SPI's webhooks go: the API's webhook route.
SIMULATOR_WEBHOOK_URL=http://127.0.0.1:3000/v1/spi/webhooks
# Injected faults, as fractions from 0 to 1 and milliseconds. None by default.
# SIMULATOR_FAULTS={"errorRate":0.1,"timeoutRate":0.1,"rejectRate":0.05,"webhookLossRate":0.1,"webhookDuplicateRate":0.1,"latencyMs":200}
PORT=4000
